<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Aya — Open when...</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><circle cx='32' cy='32' r='30' fill='%238b1a2b'/><text x='20' y='42' font-family='Georgia,serif' font-style='italic' font-size='28' fill='%23f1e3c5' text-anchor='middle'>V</text><text x='44' y='42' font-family='Georgia,serif' font-style='italic' font-size='28' fill='%23f1e3c5' text-anchor='middle'>A</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Caveat:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ============================================================
   PALETTE — deep wine + cream paper
   ============================================================ */
:root {
  --wine-deep:    #14060a;
  --wine:         #2a0a14;
  --wine-mid:     #4a1224;
  --wax:          #8b1a2b;
  --wax-dark:     #6e1422;
  --wax-light:    #b22838;
  --cream:        #eee0c0;
  --cream-light:  #f7ecce;
  --cream-shadow: #d4c39c;
  --ink:          #2b0a10;
  --ink-soft:     #5a1c24;
  --gold:         #9a7a3c;
  --cursor:       none; /* native cursor hidden; animated GIF follows via JS */
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html, body { min-height: 100%; }

body {
  font-family: 'Cormorant Garamond', serif;
  color: var(--cream);
  background:
    radial-gradient(ellipse at 50% 30%, #5a1426 0%, #2a0810 55%, #120407 100%);
  position: relative;
  min-height: 100vh;
  padding: 70px 24px 100px;
  overflow-x: hidden;
  cursor: var(--cursor);
}

/* Soft grain over everything */
body::before {
  content: '';
  position: fixed; inset: 0;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.06 0 0 0 0 0.02 0 0 0 0 0.03 0 0 0 0.55 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  opacity: 0.5;
  /* no mix-blend-mode: a full-screen blended layer forces the whole
     viewport to re-composite every frame — main source of the lag */
  pointer-events: none;
  z-index: 1;
}

/* Vignette */
body::after {
  content: '';
  position: fixed; inset: 0;
  background: radial-gradient(ellipse at center, transparent 25%, rgba(0,0,0,0.45) 75%, rgba(0,0,0,0.88) 100%);
  pointer-events: none;
  z-index: 3;
}

/* ============================================================
   HEARTS BACKGROUND LAYER
   ============================================================ */
.hearts-bg {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 2;
  overflow: hidden;
}

.heart-static,
.heart-floating {
  position: absolute;
  display: block;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' fill='%23b22838'><path d='M50,84 C50,84 14,60 14,32 C14,20 23,12 34,12 C41,12 47,16 50,22 C53,16 59,12 66,12 C77,12 86,20 86,32 C86,60 50,84 50,84 Z'/></svg>");
  background-size: contain;
  background-repeat: no-repeat;
}

.heart-floating {
  bottom: -50px;
  opacity: 0;
  animation: heartFloat linear infinite;
  will-change: transform, opacity; /* keep them on their own GPU layer */
}
/* stop the drifting hearts while a letter is open (they're behind it anyway) */
body.modal-open .heart-floating { animation-play-state: paused; }

@keyframes heartFloat {
  0%   { transform: translateY(0) translateX(0) rotate(-6deg); opacity: 0; }
  12%  { opacity: 0.18; }
  85%  { opacity: 0.18; }
  100% { transform: translateY(-110vh) translateX(40px) rotate(14deg); opacity: 0; }
}

/* ============================================================
   HEADER
   ============================================================ */
.header {
  position: relative;
  z-index: 4;
  text-align: center;
  margin-bottom: 70px;
  opacity: 0;
  animation: fadeIn 1.6s ease-out 0.2s forwards;
}

.ornament {
  font-family: 'Cormorant Garamond', serif;
  color: var(--gold);
  letter-spacing: 14px;
  font-size: 13px;
  margin-bottom: 22px;
  opacity: 0.75;
  padding-left: 14px;
}

.header h1 {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 300;
  font-style: italic;
  font-size: clamp(40px, 6.5vw, 72px);
  color: var(--cream-light);
  line-height: 1.05;
  letter-spacing: 0.5px;
}

.header h1 .name {
  font-family: 'Caveat', cursive;
  font-style: normal;
  font-weight: 500;
  color: var(--wax-light);
  font-size: 1.1em;
  margin-left: 6px;
}

.header .sub {
  font-family: 'Caveat', cursive;
  margin-top: 18px;
  color: var(--cream);
  opacity: 0.65;
  font-size: 24px;
  letter-spacing: 0.5px;
}

.header .divider {
  display: inline-block;
  width: 60px;
  height: 1px;
  background: var(--gold);
  opacity: 0.4;
  vertical-align: middle;
  margin: 0 12px 6px;
}

/* ============================================================
   DESK — envelopes scattered like letters on a table
   ============================================================ */
.desk {
  position: relative;
  z-index: 4;
  max-width: 1240px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  gap: 70px 30px;
  padding: 30px 10px;
  perspective: 1400px;
}

/* ============================================================
   ENVELOPE
   ============================================================ */
.envelope {
  position: relative;
  width: 320px;
  height: 220px;
  margin: 0 auto;
  cursor: var(--cursor);
  opacity: 0;
  transform: translateY(50px) rotate(var(--rot, 0deg));
  animation: dropIn 1s cubic-bezier(.2,.7,.25,1) forwards;
  transition: transform 0.55s cubic-bezier(.2,.7,.25,1), filter 0.5s ease;
  filter: drop-shadow(0 14px 22px rgba(0,0,0,0.55));
  transform-style: preserve-3d;
}

.envelope:hover {
  transform: translateY(-12px) rotate(var(--rot, 0deg)) scale(1.025);
  filter: drop-shadow(0 24px 36px rgba(0,0,0,0.72));
}

/* Envelope body */
.envelope-body {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, var(--cream) 0%, var(--cream-shadow) 100%);
  box-shadow:
    inset 0 0 40px rgba(120, 70, 30, 0.18),
    inset 0 -3px 6px rgba(70, 30, 15, 0.22);
}

/* Paper texture on envelope */
.envelope-body::before {
  content: '';
  position: absolute; inset: 0;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='p'><feTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='2'/><feColorMatrix values='0 0 0 0 0.42 0 0 0 0 0.28 0 0 0 0 0.14 0 0 0 0.35 0'/></filter><rect width='100%' height='100%' filter='url(%23p)'/></svg>");
  opacity: 0.55;
  mix-blend-mode: multiply;
}

/* Inner V — hint of envelope back seams */
.envelope-body::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(135deg, transparent 49.5%, rgba(80,40,20,0.10) 50%, transparent 50.5%) bottom left / 50% 60% no-repeat,
    linear-gradient(45deg,  transparent 49.5%, rgba(80,40,20,0.10) 50%, transparent 50.5%) bottom right / 50% 60% no-repeat;
  pointer-events: none;
}

/* Top flap */
.envelope-flap {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 55%;
  background: linear-gradient(180deg, var(--cream-light) 0%, var(--cream) 100%);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  transform-origin: top center;
  transition: transform 0.85s cubic-bezier(.55,.05,.25,1);
  z-index: 3;
}

.envelope-flap::before {
  content: '';
  position: absolute; inset: 0;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='p'><feTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='2'/><feColorMatrix values='0 0 0 0 0.42 0 0 0 0 0.28 0 0 0 0 0.14 0 0 0 0.35 0'/></filter><rect width='100%' height='100%' filter='url(%23p)'/></svg>");
  opacity: 0.5;
  mix-blend-mode: multiply;
  clip-path: polygon(0 0, 100% 0, 50% 100%);
}

/* Shadow cast by the flap onto the bottom of the envelope */
.envelope-flap::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 60%, rgba(70, 30, 15, 0.18) 95%, rgba(70, 30, 15, 0.3) 100%);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
}

.envelope.opened .envelope-flap {
  transform: rotateX(-175deg);
  box-shadow: 0 -10px 20px rgba(0,0,0,0.25);
}

/* Wax seal */
.seal {
  position: absolute;
  top: 48%;
  left: 50%;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  transform: translate(-50%, -50%) rotate(0deg);
  background:
    radial-gradient(circle at 32% 28%, var(--wax-light) 0%, var(--wax) 42%, var(--wax-dark) 100%);
  box-shadow:
    inset -4px -5px 10px rgba(0,0,0,0.45),
    inset 4px 4px 8px rgba(255,170,160,0.28),
    0 5px 10px rgba(0,0,0,0.5),
    0 2px 3px rgba(80,10,15,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 6;
  transition: transform 0.4s ease;
}

/* Irregular wax edges */
.seal::before {
  content: '';
  position: absolute;
  inset: -6px;
  border-radius: 50%;
  background:
    radial-gradient(circle at 18% 50%, var(--wax-dark) 0%, var(--wax-dark) 8%, transparent 9%),
    radial-gradient(circle at 82% 30%, var(--wax-dark) 0%, var(--wax-dark) 7%, transparent 8%),
    radial-gradient(circle at 50% 88%, var(--wax-dark) 0%, var(--wax-dark) 7%, transparent 8%),
    radial-gradient(circle at 92% 70%, var(--wax-dark) 0%, var(--wax-dark) 5%, transparent 6%),
    radial-gradient(circle at 8% 18%, var(--wax-dark) 0%, var(--wax-dark) 5%, transparent 6%);
  filter: blur(1px);
  opacity: 0.85;
  z-index: -1;
}

/* Impressed V & A monogram */
.seal-monogram {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 500;
  color: rgba(35, 4, 10, 0.85);
  font-size: 18px;
  letter-spacing: -1px;
  text-shadow: 1px 1px 0 rgba(255, 200, 180, 0.18);
  line-height: 1;
  user-select: none;
  position: relative;
  z-index: 2;
  white-space: nowrap;
}

.seal-monogram .amp {
  font-size: 0.65em;
  vertical-align: 0.18em;
  margin: 0 1px;
  opacity: 0.75;
}

/* "Open when..." label */
.label {
  position: absolute;
  bottom: 18px;
  left: 0; right: 0;
  text-align: center;
  font-family: 'Caveat', cursive;
  color: var(--ink);
  z-index: 4;
  pointer-events: none;
}

.label-small {
  font-size: 15px;
  opacity: 0.62;
  font-style: italic;
  display: block;
  letter-spacing: 0.5px;
  line-height: 1.1;
}

.label-main {
  font-size: 22px;
  font-weight: 600;
  display: block;
  margin-top: 0;
  color: var(--ink);
  line-height: 1.1;
}

/* Opened state — seal breaks off */
.envelope.opened .seal {
  animation: sealBreak 0.7s cubic-bezier(.4,1.6,.5,1) forwards;
}

/* ============================================================
   MODAL / LETTER
   ============================================================ */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 4, 8, 0);
  z-index: 100;
  display: flex;                 /* always in the render tree so the letter can animate */
  align-items: flex-start;
  justify-content: center;
  padding: 50px 20px;
  overflow-y: auto;
  visibility: hidden;            /* hidden + click-through until opened */
  pointer-events: none;
  transition: background 0.55s ease, visibility 0s linear 0.65s;
}

.overlay.active {
  visibility: visible;
  pointer-events: auto;
  /* near-opaque backdrop instead of backdrop-filter blur (which would re-blur
     the animating hearts behind it every frame while reading a letter) */
  background: rgba(15, 4, 8, 0.95);
  transition: background 0.55s ease, visibility 0s;
}

.letter {
  position: relative;
  width: 100%;
  max-width: 640px;
  background:
    linear-gradient(180deg, var(--cream-light) 0%, var(--cream) 100%);
  padding: 80px 70px 60px;
  margin-top: 30px;
  margin-bottom: 30px;
  box-shadow:
    0 40px 100px rgba(0,0,0,0.75),
    0 12px 30px rgba(0,0,0,0.5),
    inset 0 0 120px rgba(120, 70, 30, 0.1);
  transform: translateY(70px) scale(0.96) rotate(-2deg);
  opacity: 0;
  transform-origin: center 40%;
  transition: transform 0.75s cubic-bezier(.2, 0.8, 0.25, 1), opacity 0.55s ease;
}

.overlay.active .letter {
  transform: translateY(0) scale(1) rotate(0);
  opacity: 1;
}

/* Paper texture on the letter */
.letter::before {
  content: '';
  position: absolute; inset: 0;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='p'><feTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3'/><feColorMatrix values='0 0 0 0 0.42 0 0 0 0 0.28 0 0 0 0 0.14 0 0 0 0.3 0'/></filter><rect width='100%' height='100%' filter='url(%23p)'/></svg>");
  opacity: 0.45;
  mix-blend-mode: multiply;
  pointer-events: none;
}

/* Fold lines (letter was folded in thirds) + edge vignette */
.letter::after {
  content: '';
  position: absolute; inset: 0;
  background:
    linear-gradient(180deg, transparent 32%, rgba(100,60,30,0.10) 33%, transparent 34%),
    linear-gradient(180deg, transparent 65%, rgba(100,60,30,0.10) 66%, transparent 67%);
  box-shadow: inset 0 0 60px rgba(100, 50, 20, 0.18);
  pointer-events: none;
}

.letter-close {
  position: absolute;
  top: 18px; right: 22px;
  background: none;
  border: none;
  font-family: 'Cormorant Garamond', serif;
  font-size: 36px;
  color: var(--ink-soft);
  cursor: var(--cursor);
  opacity: 0.55;
  transition: opacity 0.25s, transform 0.3s;
  z-index: 10;
  line-height: 1;
  padding: 4px 10px;
}

.letter-close:hover {
  opacity: 1;
  transform: rotate(90deg);
}

.letter-header {
  text-align: center;
  margin-bottom: 38px;
  position: relative;
  z-index: 2;
}

.letter-date {
  font-family: 'Caveat', cursive;
  color: var(--ink-soft);
  font-size: 19px;
  opacity: 0.65;
  letter-spacing: 0.4px;
}

.letter-title {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 400;
  color: var(--ink);
  font-size: 36px;
  margin-top: 10px;
  letter-spacing: 0.3px;
  line-height: 1.15;
}

.letter-title::after {
  content: '· ✦ ·';
  display: block;
  font-size: 12px;
  color: var(--wax);
  margin-top: 18px;
  opacity: 0.65;
  letter-spacing: 6px;
}

.letter-greeting {
  font-family: 'Caveat', cursive;
  font-size: 30px;
  color: var(--wax-dark);
  margin-bottom: 22px;
  position: relative;
  z-index: 2;
}

.letter-body {
  font-family: 'Cormorant Garamond', serif;
  font-size: 19px;
  line-height: 1.75;
  color: var(--ink);
  position: relative;
  z-index: 2;
}

.letter-body p { margin-bottom: 18px; }
.letter-body em {
  color: var(--wax-dark);
  font-style: italic;
}

/* Poem quote inside a letter */
.letter-body blockquote.poem {
  border-left: 2px solid var(--wax-dark);
  padding: 6px 0 6px 24px;
  margin: 24px 0;
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 20px;
  line-height: 1.65;
  color: var(--ink);
  opacity: 0.95;
}

.letter-body blockquote.poem cite {
  display: block;
  font-family: 'Caveat', cursive;
  font-style: normal;
  font-size: 17px;
  color: var(--wax-dark);
  opacity: 0.72;
  margin-top: 14px;
  letter-spacing: 0.3px;
}

.letter-body blockquote.poem cite em {
  font-style: italic;
  color: var(--wax-dark);
}

/* Place for photo/gif */
.letter-photo {
  margin: 35px auto;
  width: 240px;
  height: 240px;
  background:
    repeating-linear-gradient(45deg, rgba(110, 60, 40, 0.06) 0px, rgba(110, 60, 40, 0.06) 12px, transparent 12px, transparent 24px),
    var(--cream-shadow);
  border: 1px solid rgba(100, 60, 40, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  box-shadow:
    0 10px 24px rgba(0,0,0,0.18),
    inset 0 0 22px rgba(100, 60, 30, 0.12);
  transform: rotate(-2deg);
  overflow: hidden;
}

.letter-photo span {
  font-family: 'Caveat', cursive;
  color: var(--ink-soft);
  opacity: 0.55;
  font-size: 17px;
  text-align: center;
  padding: 0 22px;
  line-height: 1.4;
}

.letter-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Sticker-style gif: drop the polaroid frame, let it float on the paper */
.letter-photo.has-gif {
  background: transparent;
  border: none;
  box-shadow: none;
  transform: rotate(0);
  width: 280px;
  height: 280px;
  overflow: visible;
  filter: drop-shadow(0 6px 12px rgba(60, 20, 10, 0.25));
}

.letter-photo.has-gif img {
  object-fit: contain;
}

.letter-signature {
  text-align: right;
  margin-top: 36px;
  position: relative;
  z-index: 2;
}

.letter-signature .yours {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  color: var(--ink-soft);
  font-size: 19px;
  display: block;
}

.letter-signature .name {
  font-family: 'Caveat', cursive;
  font-size: 56px;
  color: var(--wax-dark);
  margin-top: -8px;
  display: block;
  line-height: 1;
  letter-spacing: 1px;
}

.letter-signature .name::after {
  content: '';
  display: block;
  width: 90px;
  height: 1px;
  background: var(--wax-dark);
  margin-left: auto;
  margin-top: 4px;
  opacity: 0.35;
}

/* ============================================================
   FOOTER
   ============================================================ */
.footer {
  position: relative;
  z-index: 4;
  text-align: center;
  margin-top: 100px;
  padding: 24px;
  font-family: 'Caveat', cursive;
  color: var(--cream);
  opacity: 0.45;
  font-size: 20px;
}

.footer::before {
  content: '';
  display: block;
  width: 60px;
  height: 1px;
  background: var(--gold);
  margin: 0 auto 20px;
  opacity: 0.4;
}

/* ============================================================
   ANIMATIONS
   ============================================================ */
@keyframes fadeIn {
  to { opacity: 1; }
}

@keyframes dropIn {
  0%   { opacity: 0; transform: translateY(50px) rotate(var(--rot, 0deg)) scale(0.94); }
  60%  { opacity: 1; }
  100% { opacity: 1; transform: translateY(0) rotate(var(--rot, 0deg)) scale(1); }
}

@keyframes sealBreak {
  0%   { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
  30%  { transform: translate(-50%, -50%) scale(1.18) rotate(-4deg); }
  60%  { transform: translate(-58%, -42%) scale(0.95) rotate(14deg); opacity: 0.85; }
  100% { transform: translate(-72%, 30%) scale(0.8) rotate(38deg); opacity: 0; }
}

@keyframes envelopeShake {
  0%, 100% { transform: translateY(0) rotate(var(--rot, 0deg)); }
  25%      { transform: translateY(0) rotate(calc(var(--rot, 0deg) - 1.2deg)); }
  75%      { transform: translateY(0) rotate(calc(var(--rot, 0deg) + 1.2deg)); }
}

.envelope.opened { animation: envelopeShake 0.35s ease-in-out; }

/* ============================================================
   MOBILE
   ============================================================ */
@media (max-width: 768px) {
  body { padding: 40px 14px 70px; }
  .desk { gap: 50px 16px; padding: 20px 6px; }
  .envelope { width: 290px; height: 200px; }
  .letter { padding: 60px 36px 44px; margin-top: 10px; }
  .letter-title { font-size: 28px; }
  .letter-greeting { font-size: 26px; }
  .letter-body { font-size: 17px; line-height: 1.7; }
  .letter-photo { width: 200px; height: 200px; }
  .letter-signature .name { font-size: 46px; }
  .header { margin-bottom: 50px; }
  .header .sub { font-size: 21px; }
  .tm-value { font-size: clamp(2.4rem, 17vw, 5rem); }
}

/* ============================================================
   COUNT-UP TIMER — top hero (how long we've been together)
   ============================================================ */
.tm-hero {
  position: relative;
  z-index: 4;
  text-align: center;
  max-width: 920px;
  margin: 0 auto 92px;
  padding: 6px 10px 0;
  opacity: 0;
  animation: fadeIn 1.6s ease-out 0.1s forwards;
}

.tm-monogram {
  font-family: 'Cormorant Garamond', serif;
  color: var(--gold);
  letter-spacing: 12px;
  text-indent: 12px;
  font-size: 14px;
  text-transform: uppercase;
  opacity: 0.8;
  margin-bottom: 18px;
}
.tm-monogram .tm-heart { color: var(--wax-light); letter-spacing: 0; }

.tm-heading {
  font-family: 'Caveat', cursive;
  font-weight: 600;
  font-size: clamp(34px, 6vw, 62px);
  color: var(--cream-light);
  line-height: 1;
  margin-bottom: clamp(22px, 4vw, 42px);
  text-shadow: 0 2px 24px rgba(0,0,0,0.35);
}

.tm-timer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: clamp(0.6rem, 3vw, 2.2rem);
}

.tm-unit { display: flex; flex-direction: column; align-items: center; }

.tm-value {
  display: inline-block;
  overflow: hidden;
  height: 1.12em;
  line-height: 1.12;
  font-family: 'Cormorant Garamond', serif;
  font-weight: 500;
  font-size: clamp(2.6rem, 11vw, 7rem);
  color: var(--cream-light);
  font-variant-numeric: tabular-nums;
  text-shadow: 0 2px 28px rgba(0,0,0,0.5);
  /* soft fade at top & bottom so digits melt in/out as they roll */
  -webkit-mask: linear-gradient(to bottom, transparent 0, #000 13%, #000 87%, transparent 100%);
          mask: linear-gradient(to bottom, transparent 0, #000 13%, #000 87%, transparent 100%);
}
.tm-value .tm-roll {
  display: block;
  transition: transform 0.62s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: transform, filter;
}
/* motion blur: smears as the number races up, sharpens as it settles */
.tm-value .tm-roll.rolling { animation: tmRollBlur 0.62s ease-out; }
@keyframes tmRollBlur {
  0%   { filter: blur(0.015em); }
  22%  { filter: blur(0.1em); }
  100% { filter: blur(0); }
}
.tm-value .tm-d { display: block; height: 1.12em; line-height: 1.12; }

.tm-label {
  margin-top: 10px;
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(0.6rem, 1.5vw, 0.8rem);
  letter-spacing: 0.4em;
  text-indent: 0.4em;
  text-transform: uppercase;
  color: var(--gold);
  opacity: 0.85;
}

.tm-sep {
  width: 1px;
  height: clamp(2.4rem, 8vw, 5.5rem);
  align-self: center;
  margin-bottom: clamp(0.9rem, 2.5vw, 1.8rem);
  background: linear-gradient(to bottom, transparent, var(--gold), transparent);
  opacity: 0.4;
}

.tm-since {
  margin-top: clamp(20px, 4vw, 34px);
  font-family: 'Caveat', cursive;
  font-size: clamp(18px, 3vw, 24px);
  color: var(--cream);
  opacity: 0.6;
}
.tm-since sup { font-size: 0.6em; }

@media (max-width: 600px) {
  .tm-sep { display: none; }
  .tm-timer { gap: clamp(1rem, 6vw, 1.8rem) clamp(1.4rem, 9vw, 2.6rem); }
}

@media (prefers-reduced-motion: reduce) {
  .tm-value .tm-roll { transition: none; }
}

/* ============================================================
   ANIMATED GIF CURSOR — follows the pointer (native cursors
   can't animate, so we render the gif and move it ourselves)
   ============================================================ */
#customCursor {
  position: fixed;
  top: 0; left: 0;
  width: 42px;
  height: 42px;
  pointer-events: none;
  z-index: 99999;
  transform: translate3d(-100px, -100px, 0);
  opacity: 0;
  transition: opacity 0.25s ease;
  will-change: transform;
  display: none;
}
#customCursor .cur-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}
/* default cursor showing; "open" cursor hidden until over an openable thing */
#customCursor .cur-open { display: none; }
#customCursor.is-open .cur-default { display: none; }
#customCursor.is-open .cur-open { display: block; }
/* only on devices with a real pointer (skip touch screens) */
@media (hover: hover) and (pointer: fine) {
  #customCursor { display: block; }
}

/* ============================================================
   SOUND TOGGLE — bottom-right, off by default
   ============================================================ */
.sound-toggle {
  position: fixed;
  right: 22px;
  bottom: 22px;
  z-index: 9000;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: 1px solid rgba(154, 122, 60, 0.55);
  background: rgba(30, 8, 14, 0.8);
  color: var(--cream-light);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
  transition: transform 0.25s ease, border-color 0.25s ease, color 0.25s ease;
}
.sound-toggle:hover { transform: translateY(-2px) scale(1.05); border-color: var(--wax-light); }
.sound-toggle:active { transform: translateY(0) scale(0.97); }
.sound-toggle svg { width: 22px; height: 22px; display: block; }
.sound-toggle .ic-on { display: none; }
.sound-toggle.is-on { color: var(--wax-light); border-color: rgba(178, 40, 56, 0.7); }
.sound-toggle.is-on .ic-off { display: none; }
.sound-toggle.is-on .ic-on  { display: block; }
/* soft pulse while sound is playing */
.sound-toggle.is-on { animation: soundPulse 2.6s ease-out infinite; }
@keyframes soundPulse {
  0%   { box-shadow: 0 6px 18px rgba(0,0,0,0.45), 0 0 0 0 rgba(178,40,56,0.35); }
  70%  { box-shadow: 0 6px 18px rgba(0,0,0,0.45), 0 0 0 11px rgba(178,40,56,0); }
  100% { box-shadow: 0 6px 18px rgba(0,0,0,0.45), 0 0 0 0 rgba(178,40,56,0); }
}
@media (max-width: 600px) {
  .sound-toggle { right: 16px; bottom: 16px; width: 42px; height: 42px; }
}
@media (prefers-reduced-motion: reduce) {
  .sound-toggle.is-on { animation: none; }
}

/* ============================================================
   MENU — wax-seal trigger + sliding "Contents" panel
   ============================================================ */
.menu-seal {
  position: fixed;
  top: 22px; left: 22px;
  z-index: 220;
  width: 56px; height: 56px;
  border: none; padding: 0;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, var(--wax-light) 0%, var(--wax) 42%, var(--wax-dark) 100%);
  box-shadow:
    inset -4px -5px 10px rgba(0,0,0,0.45),
    inset 4px 4px 8px rgba(255,170,160,0.28),
    0 5px 12px rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.3s ease, opacity 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
}
.menu-seal .seal-monogram {
  font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 500;
  color: rgba(35,4,10,0.85); font-size: 17px; letter-spacing: -1px;
  text-shadow: 1px 1px 0 rgba(255,200,180,0.18); white-space: nowrap;
  transition: opacity 0.25s ease, transform 0.25s ease;
}
.menu-seal .seal-monogram .amp { font-size: 0.65em; vertical-align: 0.18em; opacity: 0.75; margin: 0 1px; }
/* the heart it blooms into on hover */
.menu-seal .seal-heart {
  position: absolute; inset: -3px;
  width: calc(100% + 6px); height: calc(100% + 6px);
  opacity: 0; transform: scale(0.45) rotate(-10deg);
  filter: drop-shadow(0 4px 8px rgba(0,0,0,0.5));
  transition: opacity 0.3s ease, transform 0.3s ease;
  pointer-events: none;
}
/* hover / keyboard focus → wax circle dissolves, heart pops in */
.menu-seal:hover,
.menu-seal:focus-visible { transform: scale(1.08); background: transparent; box-shadow: none; }
.menu-seal:hover .seal-monogram,
.menu-seal:focus-visible .seal-monogram { opacity: 0; transform: scale(0.6); }
.menu-seal:hover .seal-heart,
.menu-seal:focus-visible .seal-heart { opacity: 1; animation: sealHeartPop 0.5s cubic-bezier(.2,.9,.3,1.25) forwards; }
@keyframes sealHeartPop {
  0%   { transform: scale(0.45) rotate(-10deg); }
  55%  { transform: scale(1.16) rotate(3deg); }
  78%  { transform: scale(0.97) rotate(0); }
  100% { transform: scale(1) rotate(0); }
}
body.menu-open .menu-seal { opacity: 0; pointer-events: none; }
@media (prefers-reduced-motion: reduce) {
  .menu-seal:hover .seal-heart,
  .menu-seal:focus-visible .seal-heart { animation: none; transform: scale(1); }
}

.menu-backdrop {
  position: fixed; inset: 0; z-index: 200;
  background: rgba(15,4,8,0);
  visibility: hidden; pointer-events: none;
  transition: background 0.45s ease, visibility 0s linear 0.45s;
}
.menu-backdrop.open {
  background: rgba(15,4,8,0.55);
  visibility: visible; pointer-events: auto;
  transition: background 0.45s ease, visibility 0s;
}

.menu-panel {
  position: fixed; top: 0; left: 0; bottom: 0; z-index: 210;
  width: min(86vw, 320px);
  transform: translateX(-102%);
  transition: transform 0.5s cubic-bezier(.2,.8,.25,1);
  background: linear-gradient(180deg, var(--cream-light) 0%, var(--cream) 100%);
  box-shadow: 10px 0 44px rgba(0,0,0,0.55);
  padding: 62px 30px 40px;
  overflow-y: auto;
}
.menu-panel.open { transform: translateX(0); }
.menu-panel::before { /* paper texture */
  content: ''; position: absolute; inset: 0;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='mp'><feTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='2'/><feColorMatrix values='0 0 0 0 0.42 0 0 0 0 0.28 0 0 0 0 0.14 0 0 0 0.35 0'/></filter><rect width='100%' height='100%' filter='url(%23mp)'/></svg>");
  opacity: 0.4; mix-blend-mode: multiply; pointer-events: none;
}
.menu-close {
  position: absolute; top: 12px; right: 18px;
  background: none; border: none;
  font-family: 'Cormorant Garamond', serif; font-size: 34px;
  color: var(--ink-soft); line-height: 1; opacity: 0.6;
  transition: transform 0.3s, opacity 0.25s; z-index: 1;
}
.menu-close:hover { opacity: 1; transform: rotate(90deg); }
.menu-title {
  position: relative; z-index: 1;
  font-family: 'Caveat', cursive; color: var(--wax-dark);
  font-size: 32px; text-align: center; margin-bottom: 6px;
}
.menu-title::after {
  content: '· ✦ ·'; display: block; font-size: 11px;
  letter-spacing: 6px; color: var(--wax); opacity: 0.6; margin-top: 6px;
}
.menu-nav { position: relative; z-index: 1; list-style: none; margin: 26px 0 0; padding: 0; }
.menu-link {
  display: block; width: 100%; text-align: left; background: none; border: none;
  font-family: 'Cormorant Garamond', serif; font-size: 23px; color: var(--ink);
  padding: 14px 6px; letter-spacing: 0.3px;
  border-bottom: 1px solid rgba(110,60,40,0.18);
  transition: color 0.25s, padding-left 0.25s;
}
.menu-link:hover { color: var(--wax-dark); padding-left: 16px; }
.menu-link.active { color: var(--wax-dark); font-style: italic; }
.menu-link .idx { font-style: italic; color: var(--wax); opacity: 0.7; margin-right: 12px; font-size: 0.8em; }

/* ============================================================
   VIEWS / ROOMS
   ============================================================ */
.view { display: none; position: relative; z-index: 4; }
.view.is-active { display: block; animation: viewIn 0.55s ease both; }
@keyframes viewIn {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: none; }
}

.room { max-width: 1080px; margin: 0 auto; padding: 6px 6px 30px; }
.room-head { text-align: center; margin-bottom: 48px; }
.room-head .ornament {
  font-family: 'Cormorant Garamond', serif; color: var(--gold);
  letter-spacing: 14px; font-size: 13px; opacity: 0.75; padding-left: 14px;
}
.room-head h2 {
  font-family: 'Caveat', cursive; font-weight: 600; color: var(--cream-light);
  font-size: clamp(38px, 6vw, 64px); line-height: 1.04; margin-top: 12px;
  text-shadow: 0 2px 24px rgba(0,0,0,0.35);
}
.room-head p {
  font-family: 'Cormorant Garamond', serif; font-style: italic;
  color: var(--cream); opacity: 0.7; font-size: clamp(16px, 2.4vw, 20px); margin-top: 10px;
}

/* --- Our Story (timeline) --- */
.timeline { position: relative; max-width: 720px; margin: 0 auto; padding-left: 34px; }
.timeline::before {
  content: ''; position: absolute; left: 9px; top: 6px; bottom: 6px; width: 2px;
  background: linear-gradient(to bottom, transparent, var(--gold), transparent); opacity: 0.5;
}
.tl-item { position: relative; margin-bottom: 44px; }
.tl-item::before {
  content: ''; position: absolute; left: -34px; top: 7px; width: 14px; height: 14px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, var(--wax-light), var(--wax-dark));
  box-shadow: 0 0 0 4px rgba(154,122,60,0.18);
}
.tl-date { font-family: 'Caveat', cursive; color: var(--wax-light); font-size: 22px; }
.tl-title { font-family: 'Cormorant Garamond', serif; font-style: italic; color: var(--cream-light); font-size: 26px; margin: 2px 0 8px; }
.tl-text { font-family: 'Cormorant Garamond', serif; color: var(--cream); opacity: 0.82; font-size: 18px; line-height: 1.65; }

/* --- Gallery (polaroids) --- */
.gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 32px 24px; max-width: 1000px; margin: 0 auto; }
.polaroid {
  margin: 0; background: linear-gradient(180deg, var(--cream-light), var(--cream-shadow));
  padding: 12px 12px 38px; box-shadow: 0 12px 26px rgba(0,0,0,0.45);
  transform: rotate(var(--r, -2deg));
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}
.polaroid:hover { transform: rotate(0) scale(1.04); box-shadow: 0 20px 40px rgba(0,0,0,0.62); z-index: 2; position: relative; }
.polaroid .pic {
  aspect-ratio: 1 / 1; overflow: hidden; display: flex; align-items: center; justify-content: center;
  background:
    repeating-linear-gradient(45deg, rgba(110,60,40,0.06) 0 12px, transparent 12px 24px),
    var(--cream-shadow);
  box-shadow: inset 0 0 18px rgba(100,60,30,0.14);
}
.polaroid .pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
.polaroid .pic span { font-family: 'Caveat', cursive; color: var(--ink-soft); opacity: 0.5; font-size: 16px; }
.polaroid .cap { font-family: 'Caveat', cursive; color: var(--ink); text-align: center; margin-top: 10px; font-size: 18px; }

/* --- Reasons (flip cards) --- */
.reasons { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px; max-width: 980px; margin: 0 auto; align-items: start; }
.reason-cell { display: flex; flex-direction: column; }
.reason-cap { font-family: 'Caveat', cursive; color: var(--wax-light); text-align: center; font-size: 18px; opacity: 0.85; margin-top: 10px; }
.reason { aspect-ratio: 3 / 4; perspective: 900px; }
.reason-inner { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(.2,.8,.25,1); }
.reason.flipped .reason-inner { transform: rotateY(180deg); }
.reason-face {
  position: absolute; inset: 0; -webkit-backface-visibility: hidden; backface-visibility: hidden;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; padding: 20px; border: 1px solid rgba(154,122,60,0.4);
}
.reason-front { background: linear-gradient(180deg, rgba(74,18,36,0.55), rgba(33,8,16,0.55)); }
.reason-front .n { font-family: 'Cormorant Garamond', serif; font-style: italic; color: var(--gold); font-size: 30px; }
.reason-front .hint { font-family: 'Caveat', cursive; color: var(--cream); opacity: 0.55; font-size: 16px; margin-top: 10px; }
.reason-back {
  transform: rotateY(180deg);
  background: linear-gradient(180deg, var(--cream-light), var(--cream));
  color: var(--ink); font-family: 'Cormorant Garamond', serif; font-size: 18px; line-height: 1.5;
}

/* --- Playlist --- */
.playlist { max-width: 720px; margin: 0 auto; list-style: none; padding: 0; }
.song { display: flex; align-items: flex-start; gap: 16px; padding: 18px 6px; border-bottom: 1px solid rgba(154,122,60,0.2); }
.song .note-ic { color: var(--wax-light); font-size: 24px; line-height: 1.2; }
.song .meta { flex: 1; }
.song .title { font-family: 'Cormorant Garamond', serif; font-size: 22px; color: var(--cream-light); }
.song .title .artist { font-style: italic; opacity: 0.7; font-size: 0.78em; }
.song .why { font-family: 'Caveat', cursive; color: var(--wax-light); opacity: 0.85; font-size: 18px; margin-top: 4px; }
.song a { color: var(--gold); text-decoration: none; border-bottom: 1px solid rgba(154,122,60,0.4); font-size: 14px; }
.song a:hover { color: var(--wax-light); }

@media (max-width: 600px) {
  .menu-seal { width: 48px; height: 48px; top: 16px; left: 16px; }
  .room-head { margin-bottom: 34px; }
}
@media (prefers-reduced-motion: reduce) {
  .view.is-active { animation: none; }
  .reason-inner { transition: none; }
}
</style>
</head>
<body>

<!-- Animated GIF cursor (follows the mouse via JS); swaps to the "open" gif over envelopes -->
<div id="customCursor" aria-hidden="true">
  <img class="cur-img cur-default" src="cursor.gif" alt="" draggable="false">
  <img class="cur-img cur-open" src="opencursor.gif" alt="" draggable="false">
</div>

<!-- Sound on/off (music + envelope sounds) — off by default -->
<button id="soundToggle" class="sound-toggle" type="button" aria-pressed="false" aria-label="Turn background music on or off" title="Music on / off">
  <svg class="ic ic-off" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M3 9v6h4l5 4V5L7 9H3z" fill="currentColor"/>
    <path d="M16 9.5l5 5M21 9.5l-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
  </svg>
  <svg class="ic ic-on" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M3 9v6h4l5 4V5L7 9H3z" fill="currentColor"/>
    <path d="M16 8.8a4.5 4.5 0 0 1 0 6.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    <path d="M18.7 6.2a8 8 0 0 1 0 11.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
  </svg>
</button>

<!-- ============================================================
     MENU — wax seal opens the "Contents" panel
     ============================================================ -->
<button id="menuSeal" class="menu-seal" type="button" aria-label="Open menu" title="Menu">
  <span class="seal-monogram">V<span class="amp">&amp;</span>A</span>
  <svg class="seal-heart" viewBox="0 0 24 24" aria-hidden="true">
    <defs>
      <radialGradient id="sealWax" cx="34%" cy="30%" r="75%">
        <stop offset="0%" stop-color="#b22838"/>
        <stop offset="45%" stop-color="#8b1a2b"/>
        <stop offset="100%" stop-color="#6e1422"/>
      </radialGradient>
    </defs>
    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="url(#sealWax)"/>
  </svg>
</button>
<div id="menuBackdrop" class="menu-backdrop"></div>
<aside id="menuPanel" class="menu-panel" aria-label="Menu">
  <button id="menuClose" class="menu-close" type="button" aria-label="Close menu">&times;</button>
  <div class="menu-title">Contents</div>
  <ul class="menu-nav">
    <li><button class="menu-link active" data-target="view-letters"><span class="idx">I</span>Letters</button></li>
    <li><button class="menu-link" data-target="view-story"><span class="idx">II</span>Our Story</button></li>
    <li><button class="menu-link" data-target="view-reasons"><span class="idx">III</span>Reasons</button></li>
    <li><button class="menu-link" data-target="view-playlist"><span class="idx">IV</span>Playlist</button></li>
  </ul>
</aside>

<!-- Hearts background layer (populated by JS) -->
<div class="hearts-bg" id="heartsBg"></div>

<!-- ============================================================
     TIMER — how long we've been together (counts up, live)
     ============================================================ -->
<section class="tm-hero">
  <div class="tm-monogram">V <span class="tm-heart">&#10084;</span> A</div>
  <h2 class="tm-heading">Together for&hellip;</h2>
  <div class="tm-timer">
    <div class="tm-unit"><span class="tm-value" id="tmDays">0</span><span class="tm-label">Days</span></div>
    <span class="tm-sep" aria-hidden="true"></span>
    <div class="tm-unit"><span class="tm-value" id="tmHours">00</span><span class="tm-label">Hours</span></div>
    <span class="tm-sep" aria-hidden="true"></span>
    <div class="tm-unit"><span class="tm-value" id="tmMinutes">00</span><span class="tm-label">Minutes</span></div>
    <span class="tm-sep" aria-hidden="true"></span>
    <div class="tm-unit"><span class="tm-value" id="tmSeconds">00</span><span class="tm-label">Seconds</span></div>
  </div>
  <p class="tm-since">since the 27<sup>th</sup> of May, 2026 &middot; 21:51</p>
</section>

<!-- ============================================================
     VIEWS — the wax-seal menu switches between these "rooms"
     ============================================================ -->
<div id="view-letters" class="view is-active">

<!-- ============================================================
     HEADER — edit the title if you want
     ============================================================ -->
<header class="header">
  <div class="ornament">· LETTERS ·</div>
  <h1>For you, my <span class="name">Aya</span></h1>
  <div class="sub">
    <span class="divider"></span>open when you need it<span class="divider"></span>
  </div>
</header>

<!-- Desk with envelopes (generated by JS) -->
<section class="desk" id="desk"></section>

</div><!-- /#view-letters -->

<!-- ============================================================
     OUR STORY — a timeline (edit the dates & text freely)
     ============================================================ -->
<section id="view-story" class="view">
  <div class="room">
    <div class="room-head">
      <div class="ornament">· OUR STORY ·</div>
      <h2>How it began</h2>
    </div>
    <div class="timeline">
      <div class="tl-item">
        <div class="tl-date">15 Nov 2025</div>
        <div class="tl-title">The day we met</div>
      </div>
      <div class="tl-item">
        <div class="tl-date">27 May 2026</div>
